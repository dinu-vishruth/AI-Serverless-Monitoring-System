# ============================================
# AI-Driven Serverless Event Monitoring System
# Environment Variables
# ============================================

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Tables
MONITORING_TABLE=MonitoringData
AI_ANALYSIS_TABLE=AIAnalysis
INCIDENT_TABLE=Incidents
SERVICES_TABLE=Services

# AI Provider Configuration
# Options: openai, aws_bedrock
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# AWS Bedrock (if using aws_bedrock provider)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# SNS Configuration
SNS_TOPIC_ARN=
SNS_ALERT_ENABLED=true

# API Configuration
API_BASE_URL=http://localhost:8000
API_STAGE=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# ML Configuration
ML_MODEL_PATH=ml-models/
ML_RETRAIN_THRESHOLD=100
ML_CONTAMINATION=0.1

# Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/lambda/health-checker
