# AWS / environment
AWS_REGION=ap-south-2
ENVIRONMENT=development
LOCAL_MONITORING_ENABLED=true

# Database names (local SQLite in development; DynamoDB in production)
MONITORING_TABLE=MonitoringData
AI_ANALYSIS_TABLE=AIAnalysis
INCIDENT_TABLE=Incidents
SERVICES_TABLE=Services

# Real AI provider. Groq keys can also come from Secrets Manager.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_SECRET_ARN=
GROQ_MODEL=openai/gpt-oss-120b
# Optional existing provider adapters
AI_API_KEY=
AI_MODEL=gpt-4o-mini
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=ap-south-2

# Authorization: optional in explicit local mode; required in production
ADMIN_TOKEN=
ADMIN_SECRET_ARN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_BASE_URL=http://127.0.0.1:8001
API_STAGE=dev

SNS_TOPIC_ARN=
SNS_ALERT_ENABLED=true
ESCALATION_SECONDS=900
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
TELEMETRY_RETENTION_DAYS=30

ML_MODEL_PATH=ml-models/
MODEL_BUCKET=
ML_MODEL_TYPE=isolation_forest
ML_RETRAIN_THRESHOLD=100
ML_CONTAMINATION=0.1
ML_ANOMALY_THRESHOLD=0.5

# Opt in for local demos only; cloud demo is a SAM parameter
DEMO_ENABLED=false
ALLOW_PRIVATE_TARGETS=false
LOG_LEVEL=INFO
CLOUDWATCH_LOG_GROUP=/aws/lambda/health-checker
